# Conexión Postgres (Supabase: Settings → Database → Connection string → URI)
# Usa el connection pooler (puerto 6543) — es lo que Supabase recomienda para apps server-side.
# Sustituye [PASSWORD] y [PROJECT_REF].
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secreto para firmar JWTs. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Puerto del servidor NestJS
PORT=3000

# Orígenes permitidos por CORS (separados por coma). El front Python http.server suele ir a :8000.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Gemini 2.5 Flash — ranking del LLM + razonamiento (free tier 1500 RPD).
# Consíguela gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
