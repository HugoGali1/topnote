# Conexión Postgres (Supabase: Settings → Database → Connection string → URI)
# Usa el connection pooler (puerto 6543) — es lo que Supabase recomienda para apps server-side.
# Sustituye [PASSWORD] y [PROJECT_REF].
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secreto para firmar JWTs. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Puerto del servidor NestJS
PORT=3000

# Orígenes permitidos por CORS (separados por coma). OBLIGATORIO: como la sesión
# viaja en cookies, la API no puede quedar abierta a cualquier origen.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000


# ============================================================
# SESIÓN
# ============================================================
# El access token es corto y va en cookie httpOnly; el refresh es largo, rota en
# cada uso y se puede revocar. Bajar ACCESS_TOKEN_TTL reduce la ventana en la
# que un token robado sirve de algo.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d


# ============================================================
# COOKIES
# ============================================================
# En local el front (:8000) y el back (:3001) comparten "site" (el puerto no
# cuenta), así que `lax` funciona sobre http sin más.
#
# En producción con dominios distintos (app.tudominio.com / api.tudominio.com):
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true      ← obligatorio, el navegador rechaza None sin Secure
# Si comparten dominio raíz, mejor `lax` + COOKIE_DOMAIN=.tudominio.com
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.tudominio.com

# true si hay un proxy/CDN delante (Vercel, Render, Nginx). Sin esto todas las
# peticiones parecen venir de la IP del proxy y el rate limit por IP no separa
# a unos usuarios de otros.
TRUST_PROXY=false


# ============================================================
# EMAIL — verificación de cuenta y recuperación de contraseña
# ============================================================
# console = no envía nada, escribe el enlace en el log del servidor (desarrollo)
# smtp    = envío real con nodemailer (producción)
MAIL_DRIVER=console
MAIL_FROM=Top Note <no-reply@topnote.local>

# Solo con MAIL_DRIVER=smtp. Ejemplo con Resend; vale cualquier SMTP.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxx

# Base del frontend. Se usa para construir los enlaces que van en los correos.
APP_URL=http://localhost:8000

# true = no se puede iniciar sesión sin haber confirmado el email.
# Mantenlo en false mientras MAIL_DRIVER=console (si no, para entrar tendrías
# que ir a leer el enlace al log). Ponlo a true en producción, con SMTP real.
REQUIRE_EMAIL_VERIFICATION=false


# ============================================================
# ESQUEMA
# ============================================================
# Las migraciones (src/migrations) se aplican solas al arrancar. Ponlo a false
# si prefieres lanzarlas desde el pipeline con `npm run migration:run`.
RUN_MIGRATIONS=true


# ============================================================
# IA
# ============================================================
# Google Gemini 2.5 Flash — ranking del LLM + razonamiento (free tier 1500 RPD).
# Consíguela gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ...
